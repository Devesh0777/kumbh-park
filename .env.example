# Mock mode serves local JSON through the same API surface.
# Set to false once a real backend is available.
VITE_USE_MOCK=true

# Base URL used when VITE_USE_MOCK=false.
# The API is mounted at /api/v1, so this must end in /api/v1.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional bearer token used by the axios client when not in mock mode
VITE_API_TOKEN=

# Map tiles.
#   'osm'  -> public OpenStreetMap raster tiles (fine for local development only;
#             the OSM tile usage policy forbids production apps)
#   'stadia' / 'maptiler' -> set the matching key below
#   'url'  -> paste a full XYZ template into VITE_TILE_URL
VITE_TILE_PROVIDER=osm
VITE_STADIA_API_KEY=
VITE_MAPTILER_API_KEY=
VITE_TILE_URL=
