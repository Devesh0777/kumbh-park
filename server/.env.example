# --- server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nashik_parking
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# --- auth ---
# CHANGE THESE. Used to sign access/refresh JWTs and booking QR tokens.
JWT_SECRET=dev-only-change-me-access
JWT_REFRESH_SECRET=dev-only-change-me-refresh
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=30d

# Shared key for the machine-to-machine pricing/ML integration.
# The surge service sends this as X-Service-Key.
SERVICE_KEY=dev-only-change-me-service

# --- otp ---
# Dev: the OTP is returned in the API response and logged. Never in production.
OTP_EXPOSE_IN_RESPONSE=true
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_15MIN=5

# --- domain rules ---
PLATFORM_FEE_PCT=12
CURRENCY=INR
CANCEL_FREE_BEFORE_HOURS=2
DEFAULT_SEARCH_RADIUS_KM=8
MAX_SEARCH_RADIUS_KM=25
MAX_ACTIVE_BOOKINGS_PER_USER=5

# --- cors ---
CORS_ORIGIN=http://localhost:5173

# --- http ---
# Requests allowed per IP per minute (falls back to 5/min if unset - the
# library default - which throttles the smoke test and concurrency check).
RATE_LIMIT_PER_MINUTE=600
# Proxies in front of the app (0/1/...). Set to 1 behind nginx/a load balancer
# so rate limiting and audit logs see the real client IP.
TRUST_PROXY=0
